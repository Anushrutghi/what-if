# ============================================================
# The What-If Museum — environment variables (names only, no secrets)
# Copy to .env.local locally, or set in Vercel → Settings → Environment Variables.
# ============================================================

# --- Supabase (publishable values, safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Site ---
# Used for openGraph/social previews. Set to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=

# --- AI providers (server-side only, never exposed to the browser) ---

# Image generation: Stability AI (https://platform.stability.ai).
# Without this key the app runs in demo mode (CSS-filter "remixes").
STABILITY_AI_API_KEY=

# Curator narration: any OpenAI-compatible API (OpenAI, DeepSeek, Mistral, ...).
# Without LLM_API_KEY a built-in template narration is used.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
